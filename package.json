{
	"name": "betfin-template",
	"version": "0.1.0",
	"private": false,
	"license": "MIT",
	"type": "module",
	"description": "Standalone Module Federation remote template — build a React app that runs on its own and plugs into a host via a whitelabel manifest.",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"serve": "bun scripts/serve.ts",
		"typecheck": "tsc -b",
		"format": "biome format --write .",
		"check": "biome check ."
	},
	"dependencies": {
		"@betfin/sdk": "^0.1.0",
		"@tanstack/react-query": "^5",
		"clsx": "^2.1.1",
		"i18next": "^25",
		"lucide-react": "^0.545.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-i18next": "^15",
		"tailwind-merge": "^3.6.0",
		"viem": "^2",
		"wagmi": "^3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@module-federation/vite": "^1.16.14",
		"@tailwindcss/vite": "^4.3.2",
		"@types/bun": "^1",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"tailwindcss": "^4",
		"typescript": "~7.0.2",
		"vite": "^8.1.3"
	},
	"engines": {
		"node": ">=20"
	}
}
